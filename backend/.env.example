# Chat agent: SGR tool-calling via OpenAI. Other providers: openai, anthropic, claude_code, auto.
LLM_PROVIDER=sgr
SGR_CHAT_MODEL=gpt-4.1-mini
SGR_CHAT_MAX_TOKENS=2500
SGR_CHAT_TIMEOUT=55
OPENAI_API_KEY=
# Optional alternative providers
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
# Server-side refusal fallbacks (beta); 0 disables
LLM_FALLBACKS=1
# File OCR/transcription: OpenAI by default; set nitec to compare Chandra/Whisper.
MEDIA_AI_PROVIDER=openai
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_OCR_MODEL=gpt-5.6-luna
OPENAI_ASR_MODEL=gpt-transcribe
# Local-only upload playground at /lab (keep 0 on public deployments).
ENABLE_FILE_LAB=0
NITEC_API_BASE_URL=https://llm.nitec.kz/v1
NITEC_API_KEY=
# Optional local search model servers (for example, on the Brev VM or through an SSH tunnel).
# EKT_EMBEDDING_BASE_URL=http://127.0.0.1:8891/v1
# EKT_RERANK_BASE_URL=http://127.0.0.1:8892/v1
# EKT_SEMANTIC_DB_PATH=/absolute/path/to/semantic_catalog.sqlite
# EKT_RERANK_ENABLED=1
NITEC_OCR_MODEL=datalab-to/chandra-ocr-2
NITEC_ASR_MODEL=openai/whisper-large-v3-turbo
# ekt.kz test API (provided by the partner for the hackathon)
EKT_API_USER=apiuser
EKT_API_PASS=ApiEkt!2026
# Public URL of this backend (used to build cart and certificate links)
PUBLIC_BASE_URL=http://localhost:8000
# Seconds to cache ekt.kz detail responses (stock); confirmation always re-fetches live
DETAIL_CACHE_TTL=900
