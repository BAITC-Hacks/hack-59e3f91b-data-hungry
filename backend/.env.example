# LLM
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5
LLM_EFFORT=low
# Server-side refusal fallbacks (beta); 0 disables
LLM_FALLBACKS=1
# File OCR/transcription: OpenAI by default; set nitec to compare Chandra/Whisper.
MEDIA_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_OCR_MODEL=gpt-5.6-luna
OPENAI_ASR_MODEL=gpt-transcribe
# Local-only upload playground at /lab (keep 0 on public deployments).
ENABLE_FILE_LAB=0
NITEC_API_BASE_URL=https://llm.nitec.kz/v1
NITEC_API_KEY=
NITEC_OCR_MODEL=datalab-to/chandra-ocr-2
NITEC_ASR_MODEL=openai/whisper-large-v3-turbo
# ekt.kz test API (provided by the partner for the hackathon)
EKT_API_USER=apiuser
EKT_API_PASS=ApiEkt!2026
# Public URL of this backend (used to build cart links)
PUBLIC_BASE_URL=http://localhost:8000
