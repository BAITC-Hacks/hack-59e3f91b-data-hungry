[Unit]
Description=EKT AI assistant backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ekt-assistant/backend
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
